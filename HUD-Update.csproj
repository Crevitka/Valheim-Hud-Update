    <ItemGroup>
      <ShippedIcon Include="Icons\*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(ShippedIcon)" DestinationFolder="$(OutputPath)Icons" SkipUnchangedFiles="true" />
  </Target>
</Project>
